---
import Layout from "../../../layouts/Layout.astro";
import { FilmsGenresOptions, type FilmsResponse } from "../../../pocketbase-types";

export const prerender = false;

const rawRouteParam = Astro.params.id;
const routeParam = typeof rawRouteParam === "string" ? rawRouteParam : "";
const routeToken = routeParam.split("/").filter(Boolean).at(-1) ?? "";
const parsedId = routeToken && !routeToken.startsWith("new") ? routeToken.split("-")[0] : undefined;

const isCreateMode = !parsedId;
const isLoggedIn = Astro.locals.pb.authStore.isValid;
const userId = Astro.locals.pb.authStore.model?.id ?? null;
const genreOptions = Object.values(FilmsGenresOptions);

const toSlug = (value: unknown) =>
  String(value || "film")
    .normalize("NFKD")
    .replace(/[\u0300-\u036f]/g, "")
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/(^-|-$)+/g, "");

const nameFor = (personne: { id: string; nom?: string; prenom?: string }) => {
  const parts = [personne.prenom, personne.nom].filter(Boolean);
  return parts.length ? parts.join(" ") : personne.id;
};

const toDateInputValue = (value?: string | null) => (value ? String(value).slice(0, 10) : "");

let film: FilmsResponse | null = null;
let personnes: Array<{ id: string; nom?: string; prenom?: string }> = [];
let errorMessage = "";

if (isLoggedIn) {
  personnes = await Astro.locals.pb.collection("Personne").getFullList({
    sort: "nom",
    fields: "id,nom,prenom",
  });
}

if (isLoggedIn && parsedId) {
  try {
    film = await Astro.locals.pb.collection("Films").getOne(parsedId);
  } catch (error) {
    errorMessage = error instanceof Error ? error.message : "Film introuvable.";
  }
}

if (Astro.request.method === "POST") {
  if (!isLoggedIn) {
    errorMessage = "Vous devez etre connecte pour modifier ou ajouter.";
  } else {
    const data = await Astro.request.formData();

    const titre = String(data.get("titre") || "").trim();
    const dateSortie = String(data.get("dete_de_sortie") || "").trim();
    const dureMinRaw = String(data.get("dure_min") || "").trim();
    const dureMin = dureMinRaw ? Number(dureMinRaw) : null;
    const synopsis = String(data.get("synopsis") || "").trim();
    const genres = data.getAll("genres").map((v) => String(v));
    const producteur = String(data.get("producteur") || "").trim();
    const realisateur = data.getAll("realisateur").map((v) => String(v));
    const scenariste = data.getAll("scenariste").map((v) => String(v));
    const poster = data.get("poster");

    const payload = {
      titre: titre || null,
      dete_de_sortie: dateSortie || null,
      dure_min: Number.isFinite(dureMin) ? dureMin : null,
      synopsis: synopsis || null,
      genres,
      producteur: producteur || null,
      realisateur,
      scenariste,
      ...(poster instanceof File && poster.size > 0 ? { poster } : {}),
      ...(userId ? { user: userId } : {}),
    };

    try {
      const savedFilm = parsedId
        ? await Astro.locals.pb.collection("Films").update(parsedId, payload)
        : await Astro.locals.pb.collection("Films").create(payload);

      return Astro.redirect(`/films/${savedFilm.id}-${toSlug(savedFilm.titre || titre || "film")}`);
    } catch (error) {
      errorMessage = error instanceof Error ? error.message : "Erreur lors de l'enregistrement.";
    }
  }
}

const posterUrl = film?.poster ? Astro.locals.pb.files.getURL(film, film.poster) : null;
---

<Layout pageTitle={`${isCreateMode ? "Ajouter" : "Editer"} un film - PocketBase Cinema`}>
  <section class="hero-card">
    <div class="hero-glow"></div>
    <div class="relative z-10 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <span class="chip">Back-office</span>
        <h1 class="page-title mt-3">{isCreateMode ? "Ajouter un film" : "Edition film"}</h1>
        <p class="page-subtitle">Renseigne les metadonnees, genres, credits et poster du film.</p>
      </div>
      <a href="/films" class="btn-secondary">Retour a la liste</a>
    </div>
  </section>

  {!isLoggedIn && (
    <section class="section-card">
      <p class="text-sm text-slate-200">
        Vous devez vous connecter pour utiliser ce formulaire. <a class="btn-link" href="/authpassword">Se connecter</a>
      </p>
    </section>
  )}

  {errorMessage && (
    <section class="section-card border-rose-300/20 bg-rose-400/10">
      <p class="text-sm text-rose-100">{errorMessage}</p>
    </section>
  )}

  {isLoggedIn && (!parsedId || film) && (
    <section class="form-card">
      <form method="post" enctype="multipart/form-data" class="stack">
        {userId && <input type="hidden" name="user" value={userId} />}

        <div class="form-grid">
          <label class="field">
            <span class="field-label">Poster</span>
            <input class="text-input file:mr-4 file:rounded-lg file:border-0 file:bg-cyan-300/20 file:px-3 file:py-2 file:text-cyan-100" type="file" name="poster" />
          </label>

          <div class="field">
            <span class="field-label">Apercu poster</span>
            {posterUrl ? (
              <img src={posterUrl} alt="Poster actuel" class="h-32 w-full rounded-xl border border-white/10 object-cover" />
            ) : (
              <div class="flex h-32 items-center justify-center rounded-xl border border-dashed border-white/15 bg-white/5 text-sm text-slate-400">Aucun poster</div>
            )}
          </div>

          <label class="field">
            <span class="field-label">Titre</span>
            <input class="text-input" type="text" name="titre" value={film?.titre ?? ""} />
          </label>

          <label class="field">
            <span class="field-label">Date de sortie</span>
            <input class="text-input" type="date" name="dete_de_sortie" value={toDateInputValue(film?.dete_de_sortie)} />
          </label>

          <label class="field">
            <span class="field-label">Duree (min)</span>
            <input class="text-input" type="number" name="dure_min" min="0" value={film?.dure_min ?? ""} />
          </label>

          <label class="field">
            <span class="field-label">Producteur</span>
            <select class="select-input" name="producteur">
              <option value="">Aucun</option>
              {personnes.map((personne) => (
                <option value={personne.id} selected={film?.producteur === personne.id}>{nameFor(personne)}</option>
              ))}
            </select>
          </label>

          <label class="field field-full">
            <span class="field-label">Synopsis</span>
            <textarea class="text-area" name="synopsis">{film?.synopsis ?? ""}</textarea>
          </label>
        </div>

        <fieldset class="section-card">
          <legend class="field-label px-2">Genres</legend>
          <div class="checkbox-grid mt-3">
            {genreOptions.map((opt) => (
              <label class="check-chip">
                <input type="checkbox" name="genres" value={opt} checked={film?.genres?.includes(opt) ?? false} />
                <span>{opt}</span>
              </label>
            ))}
          </div>
        </fieldset>

        <div class="grid gap-4 lg:grid-cols-2">
          <fieldset class="section-card">
            <legend class="field-label px-2">Realisateur(s)</legend>
            <div class="checkbox-grid mt-3 max-h-72 overflow-auto pr-1">
              {personnes.map((personne) => (
                <label class="check-chip">
                  <input
                    type="checkbox"
                    name="realisateur"
                    value={personne.id}
                    checked={film?.realisateur?.includes(personne.id) ?? false}
                  />
                  <span>{nameFor(personne)}</span>
                </label>
              ))}
            </div>
          </fieldset>

          <fieldset class="section-card">
            <legend class="field-label px-2">Scenariste(s)</legend>
            <div class="checkbox-grid mt-3 max-h-72 overflow-auto pr-1">
              {personnes.map((personne) => (
                <label class="check-chip">
                  <input
                    type="checkbox"
                    name="scenariste"
                    value={personne.id}
                    checked={film?.scenariste?.includes(personne.id) ?? false}
                  />
                  <span>{nameFor(personne)}</span>
                </label>
              ))}
            </div>
          </fieldset>
        </div>

        <div class="actions-row">
          <button class="btn-primary" type="submit">{isCreateMode ? "Ajouter" : "Mettre a jour"}</button>
          <a class="btn-secondary" href={parsedId ? `/films/${parsedId}-${toSlug(film?.titre || "film")}` : "/films"}>Annuler</a>
        </div>
      </form>
    </section>
  )}
</Layout>
